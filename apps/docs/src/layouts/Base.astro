---
import '@nostalgiaui/tokens/tokens.css';
import '@nostalgiaui/react/styles.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A design system that renders any interface in the style of a past design era.' } =
  Astro.props;

const nav = [
  ['/', 'Overview'],
  ['/timeline/', 'Timeline'],
  ['/eras/', 'Eras'],
  ['/palettes/', 'Palettes'],
  ['/components/', 'Components'],
  ['/mcp/', 'MCP server'],
] as const;

const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · NostalgiaUI</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/">NostalgiaUI</a>
      <nav class="site-nav" aria-label="Site">
        {
          nav.map(([href, label]) => (
            <a href={href} aria-current={current === href ? 'page' : href !== '/' && current.startsWith(href) ? 'true' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
