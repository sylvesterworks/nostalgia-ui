{
  "name": "nostalgiaui",
  "version": "0.0.0",
  "private": true,
  "description": "A design system that renders any interface in the style of a past design era.",
  "license": "MIT",
  "author": "Josh Sylvester",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-server-json.mjs && pnpm install --lockfile-only",
    "release": "pnpm run build && changeset publish",
    "publish:dry-run": "pnpm -r publish --dry-run --no-git-checks --access public"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
