{
  "name": "@nostalgiaui/importer",
  "version": "0.0.0",
  "private": true,
  "description": "Convert a VS Code theme JSON into a NostalgiaUI palette.",
  "license": "MIT",
  "author": "Josh Sylvester",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nostalgiaui/tokens": "workspace:*"
  },
  "bin": {
    "nostalgiaui-import": "./dist/cli.js"
  }
}
