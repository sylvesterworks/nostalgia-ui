{
  "name": "@nostalgiaui/react",
  "version": "0.0.0",
  "description": "Base UI components styled entirely through NostalgiaUI tokens.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "base-ui",
    "retro",
    "nostalgia"
  ],
  "license": "MIT",
  "author": "Josh Sylvester",
  "homepage": "https://nostalgiaui.sylvester.works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvesterworks/nostalgia-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/sylvesterworks/nostalgia-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@nostalgiaui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
